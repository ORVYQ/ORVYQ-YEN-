{
  "schema_version": "1.0",
  "profile_id": "orvyq-aperture-cinematic",
  "description": "Project-independent creative and QA boundaries for ORVYQ cinematic documentary production.",
  "creative_limits": {
    "minimum_mobile_font_px": 36,
    "maximum_uses_per_source": 2,
    "hook": {
      "minimum_cuts": 3,
      "maximum_cuts": 6,
      "minimum_duration_seconds": 8,
      "maximum_duration_seconds": 15,
      "question_minimum_characters": 25,
      "question_maximum_characters": 120,
      "human_context_first_required": true
    },
    "editorial_rhythm": {
      "minimum_question_beats": 4,
      "maximum_question_beats": 12,
      "brief_accent_minimum_seconds": 1.5,
      "brief_accent_maximum_seconds": 3,
      "full_pause_minimum_seconds": 3
    },
    "opening_evidence": {
      "required": true,
      "allowed_kinds": [
        "split_documents",
        "official_document",
        "official_figure",
        "official_screen"
      ],
      "minimum_assets": 1,
      "maximum_assets": 3,
      "materialized_asset_prefix": "assets/evidence/",
      "allowed_extensions": [".png", ".jpg", ".jpeg", ".webp"]
    }
  }
}
