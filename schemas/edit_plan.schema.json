{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orvyq.dev/schemas/edit_plan.schema.json",
  "title": "Canonical Edit Plan",
  "description": "The single canonical edit plan used by Candidate Validation, Full-Length Review and Final Encode. Cinematic visual-module planning augments this same plan; it never creates a parallel renderer or timeline.",
  "type": "object",
  "required": ["schema_version", "project_id", "mode", "frame_range", "fps", "duration_frames", "audio_mix_asset", "shots", "quality_policy"],
  "properties": {
    "schema_version": { "const": "1.0-canonical" },
    "project_id": { "type": "string" },
    "mode": { "enum": ["candidate", "proof", "full"] },
    "frame_range": {
      "type": "object",
      "required": ["start_frame", "end_frame"],
      "properties": {
        "start_frame": { "type": "integer", "minimum": 0 },
        "end_frame": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "fps": { "const": 30 },
    "duration_frames": { "type": "integer", "minimum": 1 },
    "audio_mix_asset": { "type": "string" },
    "captions_asset": { "type": "string" },
    "brand": { "type": "object" },
    "production_mode": { "type": "string" },
    "strategy": { "type": "string" },
    "render_source_sha": { "type": ["string", "null"] },
    "art_direction": { "type": "object" },
    "motion_hook": { "type": "object" },
    "opening": {
      "type": "object",
      "required": ["plan_schema_version", "selected_archetype", "selected_score", "central_question", "title_reveal", "first_evidence", "visual_module_types"],
      "properties": {
        "plan_schema_version": { "const": "1.0-cinematic-opening" },
        "selected_archetype": { "type": "string" },
        "selected_score": { "type": "number" },
        "central_question": { "type": "string", "pattern": "\\?$" },
        "title_reveal": { "type": "object" },
        "first_evidence": { "type": "object" },
        "visual_module_types": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "blacklisted_assets": { "type": "array", "items": { "type": "string" } },
    "source_usage": { "type": "object" },
    "evidence_asset_usage": { "type": "object" },
    "shots": { "type": "array", "items": { "$ref": "shot.schema.json" } },
    "quality_policy": { "type": "object" }
  },
  "additionalProperties": false
}
