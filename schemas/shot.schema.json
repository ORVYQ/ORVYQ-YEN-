{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orvyq.dev/schemas/shot.schema.json",
  "title": "Shot",
  "description": "A canonical ORVYQ shot. Internal semantic intent is separated from the viewer-facing cinematic visual module; semantic enum names are never display instructions.",
  "type": "object",
  "required": ["shot_id", "scene_id", "start_frame", "end_frame", "asset_type", "transition_in", "transition_out"],
  "properties": {
    "shot_id": { "type": "string", "pattern": "^shot_[0-9]{3,}$" },
    "scene_id": { "type": "string" },
    "start_frame": { "type": "integer", "minimum": 0 },
    "end_frame": { "type": "integer", "minimum": 1 },
    "asset_type": { "enum": ["footage", "graphic", "evidence", "ai_fallback"] },
    "transition_in": { "enum": ["cut", "fade", "dissolve"] },
    "transition_out": { "enum": ["cut", "fade", "dissolve"] },
    "text_overlay": { "type": ["string", "null"] },
    "claim_id": { "type": "string" },
    "visual_role": { "enum": ["evidence", "archive", "context", "human_context", "metaphor", "graphic"] },
    "editorial_role": { "type": "string" },
    "editorial_purpose": { "type": "string", "minLength": 18 },
    "editorial_overlay": { "type": ["object", "null"] },
    "hook_question": {
      "type": ["object", "null"],
      "required": ["eyebrow", "question"],
      "properties": {
        "eyebrow": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "pattern": "\\?$" },
        "deck": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "emphasis_card": {
      "type": ["object", "null"],
      "properties": {
        "eyebrow": { "type": "string" },
        "title": { "type": "string" },
        "accent": { "type": ["string", "null"] },
        "anchor_text": { "type": "string" }
      },
      "additionalProperties": false
    },
    "sound_cue": { "type": ["string", "null"] },
    "video_asset": { "type": "string" },
    "trim_in_sec": { "type": "number", "minimum": 0 },
    "trim_out_sec": { "type": "number", "minimum": 0 },
    "motion_variant": { "enum": ["hold", "push", "pull", "drift_left", "drift_right"] },
    "graphic": { "type": "object" },
    "evidence": { "type": "object" },
    "section_id": { "type": "string" },
    "generic_stock": { "type": "boolean" },
    "hook_footage": { "type": "boolean" },
    "contextual_footage": { "type": "boolean" },
    "provenance_mode": { "type": "string" },
    "motif": { "type": "string" },
    "reuse_reason": { "type": "string" },
    "semantic_intent": {
      "type": "object",
      "required": ["editorial_role", "claim_type", "evidence_relationship", "certainty_level", "source_type", "narrative_function", "information_density", "emotional_tone", "visual_priority", "source_visibility_requirement"],
      "properties": {
        "editorial_role": { "type": "string" },
        "claim_type": { "type": "string" },
        "evidence_relationship": { "type": "string" },
        "certainty_level": { "type": "string" },
        "source_type": { "type": "string" },
        "narrative_function": { "type": "string" },
        "information_density": { "enum": ["low", "medium", "high"] },
        "emotional_tone": { "type": "string" },
        "visual_priority": { "type": "string" },
        "source_visibility_requirement": { "enum": ["visible", "optional"] }
      },
      "additionalProperties": false
    },
    "visual_requirements": {
      "type": "object",
      "required": ["requires_real_source", "requires_document_visibility", "requires_data_visualization", "requires_map", "requires_comparison", "requires_mechanism", "requires_human_context", "requires_motion", "requires_archival_context", "requires_scale_visualization", "available_primary_visual_count"],
      "properties": {
        "requires_real_source": { "type": "boolean" },
        "requires_document_visibility": { "type": "boolean" },
        "requires_data_visualization": { "type": "boolean" },
        "requires_map": { "type": "boolean" },
        "requires_comparison": { "type": "boolean" },
        "requires_mechanism": { "type": "boolean" },
        "requires_human_context": { "type": "boolean" },
        "requires_motion": { "type": "boolean" },
        "requires_archival_context": { "type": "boolean" },
        "requires_scale_visualization": { "type": "boolean" },
        "available_primary_visual_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "visual_module": { "$ref": "visual_module.schema.json" }
  },
  "allOf": [
    {
      "if": { "properties": { "asset_type": { "const": "footage" } } },
      "then": { "required": ["video_asset", "trim_in_sec", "trim_out_sec"] }
    },
    {
      "if": { "properties": { "asset_type": { "const": "graphic" } } },
      "then": { "required": ["graphic"] }
    },
    {
      "if": { "properties": { "asset_type": { "const": "evidence" } } },
      "then": { "required": ["evidence"] }
    }
  ],
  "additionalProperties": false
}
